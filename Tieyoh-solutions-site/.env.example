# Copy to .env and fill in real values. Do not commit .env.

# Point at your existing Azure Database for PostgreSQL instance instead of the
# local docker-compose postgres service:
SPRING_DATASOURCE_URL=jdbc:postgresql://<your-azure-postgres-host>:5432/tieyoh_solutions?sslmode=require
SPRING_DATASOURCE_USERNAME=<azure-postgres-username>
SPRING_DATASOURCE_PASSWORD=<azure-postgres-password>

# Default admin account created on first boot (change the password after first login)
ADMIN_EMAIL=admin@tieyoh.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Tieyoh Admin

UPLOADS_DIR=./uploads
PORT=8080
