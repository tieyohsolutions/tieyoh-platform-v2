<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.tieyoh</groupId>
	<artifactId>tieyoh-api</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>tieyoh-api</name>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi-ooxml</artifactId>
			<version>5.4.1</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<!-- GoogleWalletService uses ObjectMapper/JsonNode directly to parse
		     the service-account key file and build Wallet API request bodies.
		     spring-boot-starter-webmvc does not appear to pull jackson-databind
		     in at compile scope on this Spring Boot version (jjwt-jackson only
		     brings it in at runtime scope, invisible to javac), so it's listed
		     explicitly here. No version needed, since the parent BOM manages it. -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-crypto</artifactId>
		</dependency>
		<!-- Signs the "Add to Google Wallet" save JWT (RS256, service
		     account private key, loaded from GOOGLE_WALLET_SERVICE_ACCOUNT_KEY_PATH),
		     see com.tieyoh.api.wallet.service.GoogleWalletService. Spring
		     Boot's dependency management doesn't cover this artifact, hence
		     the explicit version, same as poi-ooxml above. -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.11.5</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.11.5</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>0.11.5</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- DEF-001: tests that need a database run against a throwaway
		     PostgreSQL container, never the dev database. Versions are
		     managed by the Spring Boot parent. Requires Docker. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<executions>
					<!-- REQ-001: writes META-INF/build-info.properties (name,
					     version, build time) for /actuator/info. The time is
					     fixed when the artifact is built, not at startup.
					     group and artifact are excluded: only the approved
					     fields are generated. -->
					<execution>
						<id>build-info</id>
						<goals>
							<goal>build-info</goal>
						</goals>
						<configuration>
							<excludeInfoProperties>
								<excludeInfoProperty>group</excludeInfoProperty>
								<excludeInfoProperty>artifact</excludeInfoProperty>
							</excludeInfoProperties>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- REQ-001: writes git.properties for /actuator/info with only the
			     approved git fields: short commit id, commit time (UTC) and the
			     dirty flag. Author/committer names and emails, remote URL, commit
			     message, branch, build host/user and tags are never read, so they
			     can't reach the artifact or the build log.

			     Uses the git CLI from this project directory instead of
			     git-commit-id-maven-plugin: that plugin (9.2.0 and 10.0.1, JGit and
			     native modes) resolves a linked git worktree to the main checkout
			     and reports the wrong commit / dirty flag (DEF-003). The git CLI
			     resolves worktrees, submodules and normal clones itself.

			     dirty=true when there are tracked changes (staged or not) or
			     untracked files that are not gitignored, anywhere in the
			     repository (DEF-002). "status" runs with no-optional-locks so the
			     build never writes to .git.

			     Building without a .git directory or without git installed must
			     not fail (AC-9/AC-10): any git error just means no git.properties
			     is written and the git section is omitted from /actuator/info. A
			     git.properties from an earlier build is deleted first so stale
			     values can't survive. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<executions>
					<execution>
						<id>git-properties</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target xmlns:if="ant:if">
								<property name="tieyoh.git.file" value="${project.build.outputDirectory}/git.properties"/>
								<delete file="${tieyoh.git.file}" quiet="true"/>
								<property environment="tieyoh.env"/>
								<condition property="tieyoh.git.cli">
									<or>
										<available file="git" filepath="${tieyoh.env.PATH}"/>
										<available file="git.exe" filepath="${tieyoh.env.PATH}"/>
										<available file="git.exe" filepath="${tieyoh.env.Path}"/>
									</or>
								</condition>
								<sequential if:set="tieyoh.git.cli">
									<exec executable="git" dir="${project.basedir}" failonerror="false"
											failifexecutionfails="false" outputproperty="tieyoh.git.id"
											errorproperty="tieyoh.git.id.err" resultproperty="tieyoh.git.id.rc">
										<arg value="rev-parse"/>
										<arg value="--short=7"/>
										<arg value="--verify"/>
										<arg value="HEAD"/>
									</exec>
									<exec executable="git" dir="${project.basedir}" failonerror="false"
											failifexecutionfails="false" outputproperty="tieyoh.git.time"
											errorproperty="tieyoh.git.time.err" resultproperty="tieyoh.git.time.rc">
										<env key="TZ" value="UTC"/>
										<arg value="log"/>
										<arg value="-1"/>
										<arg value="--no-show-signature"/>
										<arg value="--date=format-local:%Y-%m-%dT%H:%M:%SZ"/>
										<arg value="--format=%cd"/>
										<arg value="HEAD"/>
									</exec>
									<exec executable="git" dir="${project.basedir}" failonerror="false"
											failifexecutionfails="false" outputproperty="tieyoh.git.status"
											errorproperty="tieyoh.git.status.err" resultproperty="tieyoh.git.status.rc">
										<arg value="--no-optional-locks"/>
										<arg value="status"/>
										<arg value="--porcelain"/>
										<arg value="--untracked-files=normal"/>
									</exec>
								</sequential>
								<condition property="tieyoh.git.available">
									<and>
										<equals arg1="${tieyoh.git.id.rc}" arg2="0"/>
										<equals arg1="${tieyoh.git.time.rc}" arg2="0"/>
										<equals arg1="${tieyoh.git.status.rc}" arg2="0"/>
										<matches string="${tieyoh.git.id}" pattern="^[0-9a-f]{7,40}$"/>
									</and>
								</condition>
								<condition property="tieyoh.git.dirty" value="true" else="false">
									<length string="${tieyoh.git.status}" trim="true" when="greater" length="0"/>
								</condition>
								<echo if:set="tieyoh.git.available" file="${tieyoh.git.file}" encoding="ISO-8859-1"
										message="git.commit.id.abbrev=${tieyoh.git.id}${line.separator}git.commit.time=${tieyoh.git.time}${line.separator}git.dirty=${tieyoh.git.dirty}${line.separator}"/>
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
					<execution>
						<id>default-testCompile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
